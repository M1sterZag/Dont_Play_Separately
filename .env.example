TIME_ZONE=UTC

LOGGER_LEVEL=DEBUG

HTTP_ADDR=:5050
HTTP_SHUTDOWN_TIMEOUT=30s
HTTP_ALLOWED_ORIGINS=http://localhost:5050,null

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=5432
POSTGRES_TIMEOUT=10s

JWT_SECRET=
JWT_ACCESS_TTL=1h
JWT_REFRESH_TTL=168h
JWT_VERIFICATION_CODE_TTL=10m
JWT_VERIFICATION_CODE_LENGTH=6
JWT_MAX_VERIFICATION_ATTEMPTS=5
JWT_MIN_RESEND_INTERVAL=60s

# SMTP: для локальной разработки используем MailHog (localhost:1025, UI на :8025).
# Для прода: smtp.yandex.ru:465 / smtp.gmail.com:587 + пароль приложения.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@dps.local

S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=avatars
S3_PUBLIC_BASE_URL=http://localhost:9000
S3_USE_SSL=false
S3_REGION=us-east-1

MINIO_PORT=9000

REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TIMEOUT=5s

IGDB_CLIENT_ID=https://dev.twitch.tv/console/apps/create
IGDB_CLIENT_SECRET=https://dev.twitch.tv/console/apps/create
IGDB_BASE_URL=https://api.igdb.com/v4
